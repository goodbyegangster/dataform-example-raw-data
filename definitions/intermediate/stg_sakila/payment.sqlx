config {
  type: "view",
  tags: ["staging", "sakila"],
  database: dataform.projectConfig.defaultDatabase,
  schema: dataform.projectConfig.vars.stagingDataset,
  name: "payment",
  description: "支払い",
  columns: {
    payment_id: "支払いID",
    customer_id: "顧客ID",
    staff_id: "スタッフID",
    rental_id: "レンタルID",
    amount: "支払金額",
    payment_date: "支払日時",
    last_update: "最終更新日時",
  },
  assertions: {
    uniqueKey: ["payment_id"],
    nonNull: ["payment_id"],
  },
}

  -- raw の列を選択し、staging ビューとして公開する。
SELECT
  payment_id,
  customer_id,
  staff_id,
  rental_id,
  amount,
  payment_date,
  last_update
FROM
  ${ref(dataform.projectConfig.vars.rawDataset, "payment")}
