config {
  type: "view",
  tags: ["staging", "sakila"],
  database: dataform.projectConfig.defaultDatabase,
  schema: dataform.projectConfig.vars.stagingDataset,
  name: "film_actor",
  description: "映画出演者",
  columns: {
    actor_id: "出演者ID",
    film_id: "映画ID",
    last_update: "最終更新日時",
  },
  assertions: {
    uniqueKey: ["actor_id", "film_id"],
    nonNull: ["actor_id", "film_id"],
  },
}

  -- raw の列を選択し、staging ビューとして公開する。
SELECT
  actor_id,
  film_id,
  last_update
FROM
  ${ref(dataform.projectConfig.vars.rawDataset, "film_actor")}
