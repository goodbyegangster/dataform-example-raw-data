config {
  type: "view",
  database: dataform.projectConfig.defaultDatabase,
  schema: dataform.projectConfig.vars.stagingDataset,
  name: "city",
  description: "都市",
  columns: {
    city_id: "都市ID",
    city: "都市名",
    country_id: "国ID",
    last_update: "最終更新日時",
  }
}

-- raw の列を選択し、staging ビューとして公開する。
SELECT
  city_id,
  city,
  country_id,
  last_update
FROM ${ref(dataform.projectConfig.vars.rawDataset, "city")}
