config {
  type: "view",
  database: dataform.projectConfig.defaultDatabase,
  schema: dataform.projectConfig.vars.stagingDataset,
  name: "staff",
  description: "スタッフ",
  columns: {
    staff_id: "スタッフID",
    first_name: "名",
    last_name: "姓",
    address_id: "住所ID",
    picture: "写真",
    email: "メールアドレス",
    store_id: "所属店舗ID",
    active: "有効状態",
    username: "ユーザー名",
    password: "パスワードハッシュ",
    last_update: "最終更新日時",
  }
}

-- raw の列を選択し、staging ビューとして公開する。
SELECT
  staff_id,
  first_name,
  last_name,
  address_id,
  picture,
  email,
  store_id,
  active,
  username,
  password,
  last_update
FROM ${ref(dataform.projectConfig.vars.rawDataset, "staff")}
