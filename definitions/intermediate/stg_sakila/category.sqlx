config {
  type: "view",
  database: dataform.projectConfig.defaultDatabase,
  schema: dataform.projectConfig.vars.stagingDataset,
  name: "category",
  description: "カテゴリ",
  columns: {
    category_id: "カテゴリID",
    name: "カテゴリ名",
    last_update: "最終更新日時",
  }
}

-- raw の列を選択し、staging ビューとして公開する。
SELECT
  category_id,
  name,
  last_update
FROM ${ref(dataform.projectConfig.vars.rawDataset, "category")}
